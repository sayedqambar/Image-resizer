# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── MySQL ─────────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=change-this-root-password
DB_USERNAME=resizer
DB_PASSWORD=change-this-db-password

# ── Spring Boot backend ───────────────────────────────────────────────────────
# MUST be at least 32 characters. Generate with: openssl rand -base64 48
APP_JWT_SECRET=change-me-min-32-chars-in-production-please-update-this!!

# Comma-separated allowed CORS origins (your frontend domain)
APP_CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── AI service ────────────────────────────────────────────────────────────────
AI_MAX_UPLOAD_MB=10
